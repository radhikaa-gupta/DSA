class MyLinkedList {

    Node head;
    int size;

    public MyLinkedList() {
    }
    
    public int get(int index) {
        if (index < 0 || index >= size) return -1;
        
        Node temp = head;
        for (int i = 0; i < index; i++){ // reach index - 1 th node
            temp = temp.next;
        }
        return temp.val;
    }
    
    public void addAtHead(int val) {
        Node nnode = new Node(val);
        nnode.next = head;
        head = nnode;
        size++;
    }
    
    public void addAtTail(int val) {
        addAtIndex(size, val);
    }
    
    public void addAtIndex(int index, int val) {
        if (index < 0 || index > size) return;
        if (index == 0){
            addAtHead(val);
            return;
        } 
        Node temp = head;
        for (int i = 0; i < index - 1; i++){ // reach index - 1 th node
            temp = temp.next;
        }
        Node nnode = new Node(val);
        nnode.next = temp.next;
        temp.next = nnode;
        size++;
    }
    
    public void deleteAtIndex(int index) {
        if (index < 0 || index >= size) return;
        if (index == 0) {
            head = head.next;
            size--;
            return;
        }
        Node temp = head;
        for (int i = 0; i < index - 1; i++){ // reach index - 1 th node
            temp = temp.next;
        }
        temp.next = temp.next.next;
        size--;
    }
}

class Node{
    int val;
    Node next;

    Node(int val){
        this.val = val;
    }
}

