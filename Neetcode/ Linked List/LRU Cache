class LRUCache {    
    
    //put and get are both considered as using the key
    //hence mostrecently accessed

    HashMap<Integer, Node> hm;
    int capacity;
    Node head;
    Node tail;

    public LRUCache(int capacity) {
        // Initialize lru with +ve cap
        hm = new HashMap<>();
        this.capacity = capacity;

        head = new Node(0,0); //dummy head
        tail = new Node(0,0); //dummy tail

        head.next = tail;
        tail.prev = head;
    }
    
    public int get(int key) {
        Node node = hm.getOrDefault(key, null);
        if (node == null) return -1;
        
        // Most recently accessed 
        remove(node);
        addAtFront(node);

        return node.value;
    }
    
    public void put(int key, int value) {
        // update or create key-value pair
        // if no of keys >> cap, evict least used
        if (hm.containsKey(key)){
            Node node = hm.get(key);
            node.value = value;
            remove(node);
            addAtFront(node);
            return;
        }

        if (capacity == hm.size()){
            Node lru = tail.prev;
            remove(lru);
            hm.remove(lru.key);
        }

        Node nnode = new Node(key, value);
        hm.put(key, nnode);
        addAtFront(nnode);
    }

    private void remove(Node node){
        node.prev.next = node.next;
        node.next.prev = node.prev;
    }

    private void addAtFront(Node node){
        node.next = head.next;
        head.next.prev = node;

        node.prev = head;
        head.next = node;
    }
}

class Node{
    int key;
    int value;
    Node prev;
    Node next;

    Node(int key, int value){
        this.key = key;
        this.value = value;
    }
}



