class Solution {
    public List<String> generateParenthesis(int n) {
        List<String> ans = new ArrayList<>();
        add(n, n, new StringBuilder(), ans);
        return ans;
    }

    private void add(int open, int close, StringBuilder sb, List<String> ans){
        if (open == 0 && close == 0) {
            ans.add(sb.toString());
            return;
        }

        if (open < 0 || close < 0 || open > close) return;

        sb.append("(");
        add(open - 1, close, sb, ans);
        sb.deleteCharAt(sb.length() - 1); // backtrack

        sb.append(")");
        add(open, close - 1, sb, ans);
        sb.deleteCharAt(sb.length() - 1); // backtrack
        
    }
}
