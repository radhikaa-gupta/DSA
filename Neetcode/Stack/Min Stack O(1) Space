class MinStack {

    Stack<Long> stk;
    long minEl;

    public MinStack() {
        stk = new Stack();
    }
    
    public void push(long val) {
        if (stk.isEmpty()){
            stk.push(val);
            minEl = val;
        }
        else{
            if (val >= minEl) stk.push(val);
            else {
                //val is less than minEl - update minEl
                stk.push(val - minEl + val);
                //bcz we'll have val as minEl later which we can use to retrieve curr minEl;
                minEl = val;
            }
        }
    }
    
    public void pop() {
        if (stk.peek() >= minEl) stk.pop();
        else {
            minEl = minEl - stk.peek() + minEl;
            //flag that min element is going to be changed as at THIS EXACT MOMENT IT REPLACED PEHEL WALA
            //therefore == vali condn also sorted
            stk.pop();
        }
    }
    
    public int top() {
        if (stk.isEmpty()) return -1;
        else {
            if (stk.peek() >= minEl) return (int)stk.peek().longValue();
            else {
                //flag minEl ko change karo
                return (int)minEl;
            }
        }

    }
    
    public int getMin() {
        if (stk.isEmpty()) return -1;
        return  (int)minEl;
    }
}

