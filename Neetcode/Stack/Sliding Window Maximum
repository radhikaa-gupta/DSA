class Solution {
    public int largestRectangleArea(int[] heights) {
        // Area corresponding to a particular bar = Kitna it can extend left and right
        // <= tak
        // nsetr and nsetl se pehle tak

        Stack<Integer> stk = new Stack<>();
        int[] left = new int[heights.length];

        for (int i = 0; i < heights.length; i++){
            while (!stk.isEmpty() && heights[stk.peek()] >= heights[i]) stk.pop();
            if (stk.isEmpty()) left[i] = -1;
            else left[i] = stk.peek();
            stk.push(i);
        }

        Stack<Integer> stk2 = new Stack<>();
        int[] right = new int[heights.length];

        for (int i = heights.length - 1; i >= 0; i--){
            while (!stk2.isEmpty() && heights[stk2.peek()] >= heights[i]) stk2.pop();
            if (stk2.isEmpty()) right[i] = heights.length;
            else right[i] = stk2.peek();
            stk2.push(i);
        }

        int[] ans = new int[heights.length];
        int max = 0;
        for (int i = 0; i < ans.length; i++){
            ans[i] = (right[i] - left[i] - 1) * heights[i];
            max = Math.max(ans[i], max);
        }
        return max;
    }
}
