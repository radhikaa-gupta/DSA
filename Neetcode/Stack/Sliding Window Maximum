class Solution {
    public int[] maxSlidingWindow(int[] nums, int k) {
        
        //ngetr
        Stack<Integer> stk2 = new Stack<>();
        int[] right = new int[nums.length];

        for (int i = nums.length - 1; i >= 0; i--){
            while (!stk2.isEmpty() && nums[stk2.peek()] <= nums[i]) stk2.pop();
            if (stk2.isEmpty()) right[i] = nums.length;
            else right[i] = stk2.peek();
            stk2.push(i);
        }

        int[] maxWindow = new int[nums.length - k + 1];
        int j = 0;
        for (int i = 0; i <= nums.length - k; i++){
            if (j < i) j = i;
            while(right[j] < i + k) j = right[j];
            maxWindow[i] = nums[j];
        }

        return maxWindow;
    }
}
