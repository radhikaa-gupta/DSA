class Solution {
    public int[] nextGreaterElements(int[] nums) {
        
        // Create a monotically increasing stack for the array as if it was written twice
        // So that we can write nge for the elements towards the left (traversing circular array)
        //12343|12343 for nge after last element(circulating) we maintain stack for entire array
        
        int n = nums.length;

        Stack<Integer> stk = new Stack<>();
        int[] ans = new int[nums.length];
        for (int i = 2 * n - 1; i >= 0; i--){
            int idx = i % n;
            while(!stk.isEmpty() && nums[idx] >= stk.peek()) stk.pop();
            if(i < n){
                if (stk.isEmpty()) ans[i] = -1;
                else ans[i] = stk.peek();
            }
            stk.push(nums[idx]);
        }

        return ans;
    }
}
