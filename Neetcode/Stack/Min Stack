class MinStack {

    Stack<Integer> stk;
    Stack<Integer> helper;

    public MinStack() {
        stk = new Stack<>();
        helper = new Stack<>();
    }
    
    public void push(int val) {
        stk.push(val);
        if (helper.isEmpty() || val <= helper.peek()) helper.push(val);
    }
    
    public void pop() {
        if (helper.peek().equals(stk.peek())) helper.pop();
        stk.pop();
        
    }
    
    public int top() {
        return stk.peek();
    }
    
    public int getMin() {
        return helper.peek();
    }
}

