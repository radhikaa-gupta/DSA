class Solution {
    public int[] nextGreaterElement(int[] nums1, int[] nums2) {
        
        // Imp info given
        // -> num1 subset of num2
        // -> all int of num1 and num2 are unique

        // Question: Basically find nge of num2 array, but return in order specified in num1

        // Approach find nge for all elements in num2, store in hm, return acc to num1

        HashMap<Integer, Integer> hm = new HashMap<>();
        int[] ans = new int[nums1.length];
        Stack<Integer> stk = new Stack<>();

        for(int i = nums2.length - 1; i >= 0; i--){
            int num = nums2[i];
            while(!stk.isEmpty() && stk.peek() <= num){
                stk.pop();
            }
            if (stk.isEmpty()) hm.put(num, -1);
            else hm.put(num, stk.peek());
            stk.push(num);
        }

        for (int i = 0; i < ans.length; i++){
            ans[i] = hm.get(nums1[i]);
        }

        return ans;
    }
}
