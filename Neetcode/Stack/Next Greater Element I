class Solution {
    public int[] nextGreaterElement(int[] nums1, int[] nums2) {
        
        HashMap<Integer, Integer> hm = new HashMap<>();
        Stack<Integer> stk = new Stack<>();
        // lets create an array that stores next greatest of each element in nums2
        for (int i = nums2.length - 1; i >= 0; i--){
            if (stk.isEmpty()) hm.put(nums2[i], -1);
            else if (stk.peek() > nums2[i]) hm.put(nums2[i], stk.peek());
            else {
                while (!stk.isEmpty() && stk.peek() <= nums2[i])stk.pop();
                if (stk.isEmpty()) hm.put(nums2[i], -1);
                else hm.put(nums2[i], stk.peek());
            }
            stk.push(nums2[i]);
        }

        int[] ans = new int[nums1.length];
        for (int i = 0; i < nums1.length; i++){
            ans[i] = hm.get(nums1[i]);
        }
        return ans;
    }
}
