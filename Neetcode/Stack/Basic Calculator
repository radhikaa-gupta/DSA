class Solution {
    public int calculate(String s) {
        // Infix calculator

        Stack<Integer> num = new Stack<>();
        Stack<Character> op = new Stack<>();

        int ans = 0;
        for (int i = 0; i < s.length(); i++){

            char ch = s.charAt(i);
            if (ch == ' ') continue;

            if (Character.isDigit(ch)) {
                //Build full number;
                int number = 0;
                while(i < s.length() && Character.isDigit(s.charAt(i))){
                    number = number * 10 + (s.charAt(i) -'0');
                    i++;
                }

                num.push(number);
                i--; // step back because for-loop will increment
            }
            else if (ch == '(') op.push(ch);
            else if (ch == ')'){
                while (op.peek() != '(') num.push(process(num, op.pop()));
                op.pop();
                
            }
            else if (ch == '+' || ch == '-' || ch == '*' || ch == '/'){
                // A '-' is unary if it's at start OR follows '(', '+', '-', '*', '/'
                if (ch == '-'){
                    int prev = i - 1;
                    while(prev >= 0 && s.charAt(prev) == ' ')prev--;
                    if (prev < 0 || isOp(s.charAt(prev))) num.push(0);
                }

                while (!op.isEmpty() && op.peek() != '(' && precedence(ch) <= precedence(op.peek()) ){
                    num.push(process(num, op.pop()));
                }
                op.push(ch);
            }
        }
        while(!op.isEmpty()) num.push(process(num, op.pop()));
        return num.pop();
    }

    public int precedence(char ch){
        if (ch == '+' || ch == '-') return 1;
        else return 2;
    }

    public int process(Stack<Integer> num, char ch){
        int n2 = num.pop();
        int n1 = num.pop();
        
        switch(ch){
        case '+' : return n1 + n2;
        case '-' : return n1 - n2;
        case '*' : return n1 * n2;
        case '/' : return n1 / n2;
        default : return 0;
        }
    }

    public boolean isOp(char ch){
        return (ch == '(' || ch == '+' || ch == '-' || ch == '*' || ch == '/');
    }
}
