class StockSpanner {

    // This runs only once when the object is created.
    // Use this to initialize data structures

    Stack<Pair> stk;

    public StockSpanner() {
        stk = new Stack<>();
    }
    
    // This runs every time a new price comes in.
    public int next(int price) {
        if (stk.isEmpty()){
            stk.push(new Pair(price, 0));
            return 1;
        }
        else {
            // next greater element to the left
            int id = stk.peek().idx + 1;
            int ans = 0;

            while (!stk.isEmpty() && stk.peek().value <= price) stk.pop();
            if (stk.isEmpty()) ans = id + 1;
            else ans = id - stk.peek().idx;

            stk.push(new Pair(price, id));
            return ans;
        }
    }
}

class Pair{
    int value;
    int idx;

    public Pair(int value, int idx){
        this.value = value;
        this.idx = idx;
    }
}

