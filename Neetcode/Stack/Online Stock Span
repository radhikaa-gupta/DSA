class StockSpanner {
    // nearest greater left
    // ans = curr index - ngl
    // we are adding elements and returning ans too
    class Pair{
        int a; // price
        int b; // idx
        Pair(int a, int b){
            this.a = a;
            this.b = b;
        }
    }

    Stack <Pair> stk;
    int idx;
    public StockSpanner() {
        stk = new Stack<>();
        idx = 0;
    }
    
    public int next(int price) {
        int ans = 1;
        if (stk.isEmpty()) ans = 1;
        else if (stk.peek().a > price) {
            ans =  idx - stk.peek().b;
        }
        else{
            while(!stk.isEmpty() && stk.peek().a <= price) stk.pop();
            if(stk.isEmpty()) ans = idx + 1;
            else ans = idx - stk.peek().b;
        }
        stk.push(new Pair(price, idx));
        idx++;
        return ans;
    }
    
}

