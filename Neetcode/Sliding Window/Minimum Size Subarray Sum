class Solution {
    public int minSubArrayLen(int target, int[] nums) {
        // condn - Sum is greater than or equal to target
        // no such return 0
        int i = 0;
        int j = 0;
        int minlength = Integer.MAX_VALUE;
        int sum = 0;
        while(j < nums.length){
            sum += nums[j];
            if (sum < target){
                j++;
            }
            else {
                while(sum >= target){
                    minlength = Math.min(minlength, j - i + 1);
                    sum -= nums[i];
                    i++;
                }
                j++;
            }
        }
        if (minlength <= nums.length) return minlength;
        else return 0;
        
    }
}
