class Solution {
    public int characterReplacement(String s, int k) {
        int[] freq = new int[26];
        
        int i = 0;
        int maxLen = 0;
        int maxFreq = 0;

        for (int j = 0; j < s.length(); j++){
            freq[s.charAt(j) - 'A']++;
            maxFreq = Math.max(maxFreq, freq[s.charAt(j) - 'A'] );//jo abhi max freq h consider window USKI
            
            while (j - i + 1 - maxFreq > k){ // no of chnages > k
                freq[s.charAt(i) - 'A']--;
                i++;
            }

            maxLen = Math.max(j - i + 1, maxLen);
        }
        return maxLen;
    }
}
