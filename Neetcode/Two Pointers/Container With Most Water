class Solution {
    public int maxArea(int[] height) {
        // Paani determined by chota wala danda, amongst two
        // so if we move chota wala aage, and the size increases
        int max = 0;
        int left = 0;
        int right = height.length - 1;
        while (left < right){
            max = Math.max(max, (right - left)*Math.min(height[left], height[right]));
            if (height[left] < height[right])left++;
            else right--;
        }
        return max;
    }
}
