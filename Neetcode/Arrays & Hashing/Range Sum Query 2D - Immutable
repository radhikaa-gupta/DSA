class NumMatrix {

    //  rec defined by - upper left corner (row1, col1) and lower right corner (row2, col2).
    int[][] matrix;
    int[][] sumMat;
    public NumMatrix(int[][] matrix) {
        this.matrix = matrix;
        sumMat = new int[matrix.length][matrix[0].length];
        for (int i = 0; i < matrix.length; i++){
            for (int j = 0; j < matrix[i].length; j++){
                sumMat[i][j] = matrix[i][j];
                if (i-1 >= 0) sumMat[i][j] += sumMat[i-1][j];
                if (j-1 >= 0) sumMat[i][j] += sumMat[i][j-1];
                if (i-1 >=0 && j-1 >= 0) sumMat[i][j] -= sumMat[i-1][j-1];
            }
        }
    }
    
    public int sumRegion(int row1, int col1, int row2, int col2) {
        int sum =  sumMat[row2][col2];
        if (row1 - 1 >= 0) sum -= sumMat[row1 - 1][col2];
        if (col1 - 1 >= 0) sum -= sumMat[row2][col1 - 1];
        if (row1 - 1 >= 0 && col1 - 1 >= 0) sum += sumMat[row1-1][col1-1]; 
        return sum;

        //o[1]
    }
}

