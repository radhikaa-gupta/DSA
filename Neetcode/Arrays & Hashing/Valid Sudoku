class Solution {
    public boolean isValidSudoku(char[][] board) {
        // [["5","3",".",".","7",".",".",".","."]
        // ,["6",".",".","1","9","5",".",".","."]
        // ,[".","9","8",".",".",".",".","6","."]
        // ,["8",".",".",".","6",".",".",".","3"]
        // ,["4",".",".","8",".","3",".",".","1"]
        // ,["7",".",".",".","2",".",".",".","6"]
        // ,[".","6",".",".",".",".","2","8","."]
        // ,[".",".",".","4","1","9",".",".","5"]
        // ,[".",".",".",".","8",".",".","7","9"]]
        
        HashMap <Integer, Boolean> hm = new HashMap<>();
        // checking col wise
        for (int i = 0; i < 9; i++){
            for (int iter = 0; iter < 9; iter++)hm.put(iter+1, false);
            for (int j = 0; j < 9; j++){
                if (board[i][j]=='.')continue;
                if (hm.get(board[i][j]-'0') == true) return false;
                hm.put(board[i][j]-'0', true);
            }
        }

        // checking row wise
        for (int i = 0; i < 9; i++){
            for (int iter = 0; iter < 9; iter++)hm.put(iter+1, false);
            for (int j = 0; j < 9; j++){
                if (board[j][i]=='.')continue;
                if (hm.get(board[j][i] -'0') == true) return false;
                hm.put(board[j][i] -'0', true);
            }
        }

        // checking box wise
        for (int idx = 0; idx <= 6; idx += 3){ //idx = 3
            for (int jdx = 0; jdx <= 6; jdx += 3){
                for (int iter = 0; iter < 9; iter++)hm.put(iter+1, false);
                for (int i = idx; i < idx +3; i++){
                    for (int j = jdx; j < jdx+ 3; j++){
                        if (board[i][j]=='.')continue;
                        if (hm.get(board[i][j] -'0') == true) return false;
                        hm.put(board[i][j] -'0', true);
                    }
                }
            }
        }

        return true;
    }
}
