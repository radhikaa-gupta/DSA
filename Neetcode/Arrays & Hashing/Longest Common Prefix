        //     else ans = "";
        // }
        // return ans;

        //.indexOf -> returns first occurence

        String prefix = strs[0];
        for (int idx = 1; idx < strs.length; idx++){
            while(strs[idx].indexOf(prefix) != 0){
                prefix = prefix.substring(0, prefix.length() - 1);
            }
        }
        return prefix;
    }
