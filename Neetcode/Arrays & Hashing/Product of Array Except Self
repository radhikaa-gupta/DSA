class Solution {
    public int[] productExceptSelf(int[] nums) {
        // nums =    [24, 12, 8, 4]
        // postfix = [24,24,12, 4]
        //           prefix = 6
        int n = nums.length;
        int[] postfix = new int[n];
        postfix[n-1] = nums[n-1];
        for (int i = n - 2; i >= 0; i--){
            postfix[i] = nums[i] * postfix[i+1];
        }

        // prefix[0] = postfix[1]
        int prefix = 1;
        for (int i = 0; i < n-1; i++){
            int tmp = nums[i];
            nums[i] = prefix * postfix[i+1];
            prefix *= tmp;
        }
        nums[n-1] = prefix;
        return nums;
        
    }
}
