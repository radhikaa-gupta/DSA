class Solution {
    public int nextGreaterElement(int n) {
        // 65738754
        // 1. Find the "Pivot": first instance where dec from right to left 
        // 2. Find element just greater than pivot
        // 3. Swap both
        // 4. Reverse suffix to form smallest 

        char[] digits = Integer.toString(n).toCharArray();

        boolean isPivot = false;

        for (int i = digits.length-2; i >= 0; i--){
            if (digits[i] < digits[i+1]){
                isPivot = true;
                //Successor
                int j = digits.length - 1;
                while(digits[j] <= digits[i]) j--;

                //swap(digits, i, j);
                char temp = digits[i];
                digits[i] = digits[j];
                digits[j] = temp;

                // reverse(digits, i+1);
                int l = i + 1;
                int r = digits.length - 1;
                while(l < r){
                    temp = digits[l];
                    digits[l] = digits[r];
                    digits[r] = temp;
                    l++;
                    r--;
                }

                break;
            }
        }

        long result = 0;
        for (char ch : digits){
            result = result * 10 + (ch - '0');
        }

        if (!isPivot) return -1;
        return result > Integer.MAX_VALUE ? -1 : (int) result;
    }
}
