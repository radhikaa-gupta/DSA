class Solution {
    public boolean isAnagram(String s, String t) {
        int[] chr = new int[26];
        for (char ch : s.toCharArray()){
            chr[ch - 'a']++;
        }
        for (char ch : t.toCharArray()){
            chr[ch - 'a']--;
        }

        boolean anagram =true;
        for (int ch : chr){
            if (ch != 0) {
                anagram = false;
                break;
            }
        } 

        return anagram;
    }
}
