class Solution {
    public int[] findIntersectionValues(int[] nums1, int[] nums2) {
        HashSet<Integer> hs1 = new HashSet<>();
        HashSet<Integer> hs2 = new HashSet<>();
        int asw1 = 0;
        int asw2= 0;

        for (int num : nums1){
            hs1.add(num);
        }
        
        for (int num : nums2){
            if (hs1.contains(num)) asw2++;
            hs2.add(num);
        }

        for (int num : nums1){
            if (hs2.contains(num)) asw1++;
        }

        return new int[]{asw1, asw2};
            
        
    }
}
