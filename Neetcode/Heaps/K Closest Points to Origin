class Solution {
    
    class Pair implements Comparable<Pair>{
        int dis;
        int x;
        int y;

        Pair(int dis, int x, int y){
            this.dis = dis;
            this.x = x;
            this.y = y;
        }
        
        @Override
        public int compareTo(Pair other){
            return other.dis - this.dis;
        }
    }

    public int[][] kClosest(int[][] points, int k) {
        // Heap solution

        PriorityQueue<Pair> pq = new PriorityQueue<>();
        for (int[] el : points){
            int x = el[0];
            int y = el[1];
            int dis = x * x + y * y;
            pq.add(new Pair(dis, x, y));
            if (pq.size() > k) pq.poll();
        
        }
        int[][] ans = new int[k][2];
        for (int i = 0; i < k; i++){
            Pair p = pq.poll();
            ans[i][0] = p.x;
            ans[i][1] = p.y;
        }
        return ans;
    }
}
