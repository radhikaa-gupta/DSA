class Solution {
    public int search(int[] nums, int target) {
        // left rotated -> clockwise -> # rotations = num.length - idx(min) % num.length
        int n = nums.length;
        // find min idx 
        int start = 0;
        int end = n - 1;
        int idx = 0; 
        while(start <= end){
            int mid = start + ((end - start) / 2);
            if (nums[mid] < nums[(mid - 1 + n)%n] && nums[mid] <= nums[(mid + 1) %n]) {
                idx = mid;
                break;
            }
            else if (nums[mid] <= nums[n - 1]) end = mid - 1; // search in left 
            else start = mid + 1;

        }

        // min index in idx;
        if (target <= nums[n -1]) return bs(nums, idx, n-1, target);
        return bs(nums, 0, idx-1, target );
    }

    private int bs(int[] nums, int start, int end, int target){
        while(start <= end){
            int mid = start + (end - start) / 2;
            if (nums[mid] == target) return mid;
            else if (nums[mid] > target) end = mid -1;
            else start = mid + 1;
        }
        return -1;
    }
}
