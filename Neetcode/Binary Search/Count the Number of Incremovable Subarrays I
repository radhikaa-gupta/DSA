class Solution {
    public int incremovableSubarrayCount(int[] nums) {
        int count = 0;
        for (int i = 0; i < nums.length; i++){ // i = 2
            for (int j = i; j < nums.length; j++){ // j = 2
                // check left incr
                boolean valid = true;
                for (int k = 1; k < i; k++){
                    if (nums[k] <= nums[k-1]) {
                        valid = false;
                        break;
                    }
                }
                // check right inc
                 for (int k = j+2; k < nums.length; k++){
                    if (nums[k] <= nums[k-1]){
                        valid = false;
                        break;
                    }
                }
                // check last > right last
                if (i > 0 && j < nums.length - 1 && nums[i-1] >= nums[j+1]) {
                    valid = false;
                };

                if (valid == true) count++;
            }
        }

        return count;
    }
}
