class Solution {
    public int findMin(int[] nums) {
        int start = 0;
        int end = nums.length - 1;
        int n = nums.length;
        while(start <= end){
            if (start == end) return nums[start];
            int mid = start + ((end - start) / 2);
            if (nums[mid] < nums[(mid - 1 + n) % n] && nums[mid] < nums[(mid+1)%n]){
                return nums[mid];
            }
            else if (nums[mid] < nums[end]){
                end = mid - 1;
            }
            else start = mid + 1;
        }
        return -1;
    }
}
