class ExamTracker {

    // two parallel arrays: time - prefixsum
    // sum between start time and end time = 
    // prefixsum (uberbound) - prefixsum(lowerbound - 1 or 0)
    // lowwerbound = time equals or just greater than startTime
    // upperbound = time equals or just smaller than endTime

    List<Integer> Time;
    List<Integer> prefixSum; // prefix[i] =  sum of scores upto time time[i]
    
    public ExamTracker() {
        Time = new LinkedList<>();
        prefixSum = new LinkedList<>();
    }
    
    public void record(int time, int score) {
        Time.add(time);
        if (prefixSum.size() == 0)prefixSum.add(score);
        else prefixSum.add(prefixSum.get(prefixSum.size() - 1) + score);
    }
    
    public long totalScore(int startTime, int endTime) {
        int lb = justGreaterOrEqual(startTime);
        int ub = justSmallerOrEqual(endTime);
        if (lb == 0) return prefixSum.get(ub);
        else return prefixSum.get(ub) - prefixSum.get(lb - 1);
    }

    public int justGreaterOrEqual(int startTime){
        int n = Time.size();
        int start = 0;
        int end = n - 1;
        int lb = 0;
        while(start <= end){
            int mid = start + ((end - start)/2);
            if (Time.get(mid) <  startTime){
                start = mid + 1;
            }
            else if (Time.get(mid) >= startTime){
                lb = mid;
                end = mid - 1;
            }
        }
        return lb;
    }

    public int justSmallerOrEqual(int endTime){
        int n = Time.size();
        int start = 0;
        int end = n - 1;
        int ub = n - 1;
        while(start <= end){
            int mid = start + ((end - start)/2);
            if (Time.get(mid) <=  endTime){
                ub = mid;
                start = mid + 1;
            }
            else if (Time.get(mid) > endTime){
                end = mid - 1;
            }
        }
        return ub;
    }
}

