class Solution {
    public int searchInsert(int[] nums, int target) {
        // similar to find ceil value
        // find nearest larget element

        int start = 0;
        int end = nums.length - 1;
        int ans = Integer.MAX_VALUE;
        int idx = nums.length; // if not index found means all smaller means
        while(start <= end){
            // target = 2
            int mid = start + ((end - start)/2);
            if (nums[mid] == target) return mid;
            else if (target < nums[mid]){
                if (nums[mid] < ans){
                    ans = nums[mid];
                    idx = mid;
                }
                end = mid - 1;
            }
            else {
                start = mid + 1;
            }
        }
        return idx;
    }
}
