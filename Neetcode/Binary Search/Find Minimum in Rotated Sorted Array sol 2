class Solution {
    public int findMin(int[] nums) {
        // Binary search - O(log n)
        // end wale se comparison will tell u if its in mormal side or rotated side

        int start = 0;
        int end = nums.length - 1;
        while (start <= end){
            int mid = start + (end - start)/2;

            if (mid == end) return nums[mid];
            else if (nums[mid] > nums[end]){ // lies in rotated
                start = mid + 1;
            } else { // lies in non rotated
                end = mid;
            }
        }
        return -1;
    }
}
