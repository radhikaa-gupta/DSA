class Solution {
    public char nextGreatestLetter(char[] letters, char target) {
        // ceil
        // similar to find ceil value
        // find nearest larget element

        int start = 0;
        int end = letters.length - 1;
        char ans = 'z';
        int idx = letters.length; // if not index found means all smaller means
        if (target >= letters[end]) return letters[0];
        while(start <= end){
            // target = 2
            int mid = start + ((end - start)/2);
            if (target < letters[mid]){
                if (letters[mid] < ans){
                    ans = letters[mid];
                    idx = mid;
                }
                end = mid - 1;
            }
            else {
                start = mid + 1;
            }
        }
        
        return ans;
    }
}
