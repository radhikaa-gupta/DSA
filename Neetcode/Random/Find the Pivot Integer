class Solution {
    public int pivotInteger(int n) {
        // 1 + 2 + 3 + ... x = x + x + 1 + x + 2 .. + n
        int sumTillN = (n * (n + 1)) / 2;
        int sumTillX = 0;
        for (int x = 1; x <= n; x++){
            sumTillX += x;
            int sumRight = sumTillN - sumTillX + x;
            if (sumRight == sumTillX) return x;
        }
        return -1;
    }
}

